// Redirects other addresses to https://gedcomtools.com (see worker.js).
// Deploy from this folder: npx wrangler deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gedcomtools-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-11-26",
  "routes": [
    { "pattern": "www.gedcomtools.com", "custom_domain": true },
    { "pattern": "gedcomtools.org", "custom_domain": true },
    { "pattern": "www.gedcomtools.org", "custom_domain": true },
    { "pattern": "gedcom.vashonsoftware.com", "custom_domain": true }
  ]
}
